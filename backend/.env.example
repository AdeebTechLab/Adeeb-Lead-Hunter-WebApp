APP_NAME=Adeeb Lead Hunter
ENVIRONMENT=development
API_PREFIX=/api
SECRET_KEY=development-secret-change-before-production-123456
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENABLE_API_DOCS=true

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ai_lead_hunter
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=0

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_PUBLIC_SIGNUP=true

DEFAULT_ADMIN_NAME=Admin User
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_CNIC=00000-0000000-0
DEFAULT_ADMIN_CITY=Islamabad

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PROFILE_FOLDER=ai-lead-hunter/profiles
PROFILE_IMAGE_MAX_BYTES=1048576

GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
GOOGLE_CONTACT_ENRICHMENT_LIMIT=8

# Optional free-tier contact cross-check. Keeps Geoapify/OSM as the discovery sources.
TOMTOM_API_KEY=
TOMTOM_BASE_URL=https://api.tomtom.com
TOMTOM_CONTACT_ENRICHMENT_LIMIT=12
TOMTOM_CONTACT_MATCH_RADIUS_M=3500
TOMTOM_CONTACT_TIMEOUT_SECONDS=8
TOMTOM_CONTACT_CACHE_TTL_SECONDS=604800

ENABLE_WEBSITE_CONTACT_ENRICHMENT=true
WEBSITE_CONTACT_ENRICHMENT_LIMIT=10
WEBSITE_CONTACT_TIMEOUT_SECONDS=6

PUBLIC_DATA_USER_AGENT=AILeadHunter/1.0 (contact: you@example.com)
PUBLIC_DATA_REFERER=http://localhost:5173
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.nchc.org.tw/api/interpreter
PROVIDER_RETRY_ATTEMPTS=2
PROVIDER_TIMEOUT_SECONDS=35
PROVIDER_CACHE_TTL_SECONDS=900
